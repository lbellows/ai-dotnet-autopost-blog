# Local secrets for the blog generator. Copy to .env and fill in the values you need.
# .env is gitignored; the generator loads it automatically at startup, and real
# environment variables always take priority over anything set here.

# Anthropic provider: dotnet run --project BlogGenerator -- anthropic
ANTHROPIC_API_KEY=

# Azure Foundry provider: dotnet run --project BlogGenerator -- foundry
FOUNDRY_OPENAI_ENDPOINT=
FOUNDRY_PROJECT_API_KEY=

# Venice provider: dotnet run --project BlogGenerator -- venice
VENICE_API_KEY=

# Optional: meme generation (ImgflipMemeEnabled in appsettings.json)
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=
